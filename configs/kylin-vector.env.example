# System vector SDK route. Paths and dimensions must match the V11 machine.
OS_AGENT_MEMORY_BACKEND=kylin
OS_AGENT_KYLIN_VECTOR_LIBRARY=/absolute/path/libmokoa_kylin_vector_bridge.so
OS_AGENT_KYLIN_VECTOR_TIMEOUT_MS=5000
# Leave unset to use the SDK's per-user system Unix socket.
# OS_AGENT_KYLIN_VECTOR_ENDPOINT=unix:/tmp/kylin-ai-vector-engine-1000.sock
# Use a dedicated collection, not a pre-existing BGE-M3 collection.
OS_AGENT_MILVUS_COLLECTION=mokoa_kylin_sdk
OS_AGENT_EMBEDDING_BACKEND=kylin
OS_AGENT_KYLIN_STRICT=1
# Replace with the actual embedding output dimension, verified on the machine.
MEMORY_VECTOR_DIM=768
