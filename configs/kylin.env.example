# Copy values into the service environment on Kylin OS.
# Do not put API keys in this tracked example.

OS_AGENT_MEMORY_BACKEND=milvus
# Milvus Lite (single-process demo):
OS_AGENT_MILVUS_URI=./data/os_agent_memory.db
# Or remote/standalone Milvus:
# OS_AGENT_MILVUS_URI=http://127.0.0.1:19530
OS_AGENT_MILVUS_COLLECTION=os_agent_memory

OS_AGENT_EMBEDDING_BACKEND=kylin
# Strict mode is mandatory for acceptance: never replace Kylin SDK results
# with BGE-M3/hash vectors when the SDK fails.
OS_AGENT_KYLIN_STRICT=1

# Set only when automatic .so discovery fails:
# KYLIN_EMBEDDING_LIBRARY=/usr/lib/x86_64-linux-gnu/libkysdk-coreai-embedding.so

MEMORY_VECTOR_DIM=1024
