# 本地密钥模板 —— 复制本文件为 .env 并填入真实值，切勿提交 .env
# 用法：cp .env.example .env  然后编辑 .env
# Windows：Copy-Item .env.example .env

# ===== 硅基流动（SiliconFlow）偏好提取 LLM 后端（OpenAI 兼容）=====
# 复制自硅基流动控制台 https://siliconflow.cn 的 API Keys
SILICONFLOW_API_KEY=sk-your-real-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2

# ===== 通用 LLM（LM Studio / OpenAI 兼容），用于语义级脱敏、图片视觉描述等 =====
# 本地 LM Studio 通常无需真实 key，占位即可；端点/模型名可用 .env 覆盖
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=phi-3.1-mini-128k-instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== HuggingFace 镜像站 =====
# 国内无法直连 huggingface.co 时，设此变量让 sentence-transformers / huggingface_hub
# 从镜像下载 BGE-M3 等模型，避免模型下载卡死（load_env 启动时会注入）。
# 也可在 shell 里临时设置： $env:HF_ENDPOINT = "https://hf-mirror.com"
HF_ENDPOINT=https://hf-mirror.com

# ===== 对话 Agent 与工具调用 =====
# 是否允许模型主动调用工具（function calling）。默认 0 关闭；
# 设为 1 后，会按可用性自动注册 search_memory（记忆检索）等工具。
# 注意：要求所用模型支持 function calling。
AGENT_ENABLE_TOOLS=0

# 是否允许模型调用 exec_terminal 终端工具（在本机执行命令）。默认 0 关闭。
# ！！！风险提示！！！ 该工具等同把本机命令行交给模型，仅建议在可信的
# 开发/自用环境开启。已内置多重约束（仍无法做到完全沙箱化）：
#   1) 不使用 shell，杜绝命令注入
#   2) 拒绝命令链、管道、命令替换（; & | `）
#   3) 拒绝删除/格式化/提权/关机等破坏性命令
#   4) 拒绝访问沙箱根目录之外的绝对路径与 .. 逃逸
#   5) 强制超时（默认 15s，上限 60s）并截断超长输出
# 如确有必要，请同时确认 AGENT_EXEC_CWD 指向一个可接受的目录。
AGENT_ENABLE_EXEC_TOOL=0

# 是否允许模型调用 web_fetch 抓取网页（联网出站）。默认 0 关闭。
# 联网会引入数据外泄风险（模型可把任意 URL 交给服务端请求），仅可信环境开启。
AGENT_ENABLE_WEB_TOOL=0

# exec_terminal 的沙箱根目录，命令只会在此目录内执行。
# 留空则使用服务进程的工作目录（通常是项目根目录）。
AGENT_EXEC_CWD=
